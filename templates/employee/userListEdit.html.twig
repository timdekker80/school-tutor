{% extends 'base.html.twig' %}

{% block title %}Product Bewerken{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Product bewerken</h1>

        {{ form_start(UserTypeForm) }}
        <div class="mb-3">
            {{ form_row(UserTypeForm.email) }}
        </div>
        <div class="mb-3">
            {{ form_row(UserTypeForm.roles) }}
        </div>
        <div class="mb-3">
            {{ form_label(UserTypeForm.plainPassword) }}
            {{ form_widget(UserTypeForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(UserTypeForm.plainPassword) }}
        </div>
        <button class="btn btn-primary">Opslaan</button>
        <a href="{{ path('employee_user_list') }}" class="btn btn-secondary">Annuleren</a>
        {{ form_end(UserTypeForm) }}
    </div>
{% endblock %}
