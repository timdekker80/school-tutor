{% extends 'base.html.twig' %}

{% block title %}Nieuw product toevoegen{% endblock %}

{% block body %}
    <h1>Nieuw product toevoegen</h1>

    {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.price) }}
    {{ form_row(form.description) }}
    {{ form_row(form.categories) }}
    {{ form_row(form.img) }}

    <button class="btn btn-success mt-3">Opslaan</button>
    {{ form_end(form) }}

    <a href="{{ path('employeeProducts') }}" class="btn btn-secondary mt-3">Terug naar webshop beheer</a>
{% endblock %}
