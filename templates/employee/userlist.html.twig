{% extends 'base.html.twig' %}

{% block title %}Docenten overzicht{% endblock %}

{% block body %}
    <h1>Gebruikersoverzicht</h1>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>Email</th>
            <th>Naam</th>
            <th>Rol(len)</th>
            <th>Acties</th>
        </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.email }}</td>
                <td>{{ user.firstName ?? 'Onbekend' }}</td>
                <td>
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">{{ role }}</span>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('employee_user_list_edit', {id: user.id}) }}" class="btn btn-warning btn-sm">Bewerk</a>
                    <form action="{{ path('employee_user_list_delete', {id: user.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Weet je zeker dat je deze gebruiker wilt verwijderen?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                        <button class="btn btn-danger btn-sm">Verwijder</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Geen gebruikers gevonden.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
